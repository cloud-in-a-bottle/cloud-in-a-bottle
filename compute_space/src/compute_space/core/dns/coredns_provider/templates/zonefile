$ORIGIN {{ zone_domain }}.
$TTL {{ default_ttl }}
@   IN SOA  ns.{{ zone_domain }}. admin.{{ zone_domain }}. (
    {{ serial }}   ; serial
    3600  ; refresh
    600   ; retry
    86400 ; expire
    60    ; minimum
)
@   IN NS   ns.{{ zone_domain }}.
ns  IN A    {{ public_ip }}
@   IN A    {{ public_ip }}
*   IN A    {{ public_ip }}
{% for r in records %}
{{ r.name }}   {{ r.ttl }}  IN {{ r.type }}  {{ r.data }}
{%- endfor %}
