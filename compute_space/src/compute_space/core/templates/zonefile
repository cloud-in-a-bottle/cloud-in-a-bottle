$ORIGIN {{ zone_domain }}.
$TTL 300
@   IN SOA  ns.{{ zone_domain }}. admin.{{ zone_domain }}. (
    {{ serial }}   ; serial
    3600  ; refresh
    600   ; retry
    86400 ; expire
    60    ; minimum
)
@   IN NS   ns.{{ zone_domain }}.
ns  IN A    {{ record_ip }}
@   IN A    {{ record_ip }}
*   IN A    {{ record_ip }}
{% if record_ip6 %}
ns  IN AAAA {{ record_ip6 }}
@   IN AAAA {{ record_ip6 }}
*   IN AAAA {{ record_ip6 }}
{% endif %}
